    "typecheck:ui": "tsc -b tsconfig.ui.json",
    "typecheck:runtime": "tsc -b tsconfig.runtime.json",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build && vite build --config vite.runtime.config.ts"
  },
  "dependencies": {
    "@tempo/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  }
}
