{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tempo.local/schemas/plugin-repository-v1.schema.json",
  "title": "Tempo Plugin Repository Index",
  "description": "Schema for a Git repository index consumed by Tempo. Cross-entry duplicate and nested-path checks are additionally enforced by Tempo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "plugins"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema URL for editor tooling. Ignored by Tempo."
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/repositoryId"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Legacy display name. New repositories omit this field."
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https?://"
    },
    "plugins": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/pluginEntry"
      }
    }
  },
  "$defs": {
    "repositoryId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "$ref": "#/$defs/pluginId"
        }
      ]
    },
    "pluginId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:builtin|tempo)(?:\\.|$))[a-z0-9]+(?:\\.[a-z0-9-]+)+$"
    },
    "pluginEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": {
          "$ref": "#/$defs/pluginId"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)(?:\\.|\\.\\.|\\.git)(?:/|$))(?!.*//)(?!.*:)(?!.*\\\\).+$"
        }
      }
    }
  }
}
