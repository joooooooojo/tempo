{
  "$schema": "../../../docs/schemas/plugin-manifest.schema.json",
  "manifestVersion": 1,
  "id": "com.example.hello",
  "name": "Hello 示例插件",
  "version": "1.0.7",
  "engines": {
    "tempo": ">=1.1.2",
    "pluginApi": "^1.2.0"
  },
  "kind": "hybrid",
  "author": "Tempo",
  "publisher": "tempo-examples",
  "description": "Phase 1 插件系统最小示例：一个面板应用 + 一个快捷操作，共用同一个 Runtime 命令。",
  "homepage": "https://example.com/tempo-plugins/hello",
  "license": "MIT",
  "categories": ["tools"],
  "main": "main.mjs",
  "capabilities": ["filesystem"],
  "contributes": {
    "apps": [
      {
        "id": "main",
        "name": "Hello 示例",
        "keywords": ["hello", "示例", "demo"],
        "icon": "icons/app.svg",
        "entry": "index.html",
        "windowMode": "normal",
        "sessionVersion": 1
      },
      {
        "id": "window",
        "name": "Hello 独立窗口",
        "keywords": ["hello", "示例", "window", "窗口"],
        "icon": "icons/app.svg",
        "entry": "index.html",
        "windowMode": "standalone",
        "rect": {
          "x": "center",
          "y": "center"
        },
        "sessionVersion": 1
      }
    ],
    "actions": [
      {
        "id": "open-input",
        "name": "使用当前输入",
        "keywords": ["input", "输入", "图片"],
        "icon": "icons/app.svg",
        "accepts": ["text", "image"],
        "app": "main"
      },
      {
        "id": "say-hello",
        "name": "Hello 一下",
        "keywords": ["hello", "示例"],
        "icon": "icons/app.svg",
        "accepts": ["text"],
        "command": "hello"
      }
    ],
    "commands": [
      {
        "id": "hello",
        "title": "Hello",
        "visibility": "private"
      }
    ],
    "mcpTools": [
      {
        "name": "say-hello",
        "description": "Write a greeting to the plugin log and show a notification",
        "command": "hello",
        "inputSchema": {
          "type": "object",
          "properties": {
            "who": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "who": { "type": "string" },
            "timestamp": { "type": "string" },
            "logPath": { "type": "string" }
          },
          "required": ["who", "timestamp", "logPath"],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        }
      }
    ],
    "settings": [
      {
        "id": "loud",
        "type": "switch",
        "title": "大声打招呼",
        "description": "通知文案使用大写",
        "default": false
      },
      {
        "id": "default-who",
        "type": "input",
        "title": "默认称呼",
        "description": "未传入 who 时使用的名字",
        "default": "world",
        "placeholder": "world"
      }
    ]
  }
}
