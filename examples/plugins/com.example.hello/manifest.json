{
  "$schema": "../../../docs/schemas/plugin-manifest.schema.json",
  "manifestVersion": 1,
  "id": "com.example.hello",
  "name": "Hello 示例插件",
  "version": "1.0.9",
  "engines": {
    "tempo": ">=1.1.2",
    "pluginApi": "^1.3.0"
  },
  "kind": "hybrid",
  "author": "Tempo",
  "publisher": "tempo-examples",
  "description": "Phase 1 插件系统最小示例：一个面板应用 + 一个快捷操作，共用同一个 Runtime 命令。",
  "homepage": "https://example.com/tempo-plugins/hello",
  "license": "MIT",
  "categories": ["tools"],
  "main": "main.mjs",
  "capabilities": ["filesystem"],
  "contributes": {
    "apps": [
      {
        "id": "main",
        "name": "Hello 示例",
        "keywords": ["hello", "示例", "demo"],
        "icon": "icons/app.svg",
        "entry": "index.html",
        "windowMode": "normal",
        "sessionVersion": 1
      },
      {
        "id": "window",
        "name": "Hello 独立窗口",
        "keywords": ["hello", "示例", "window", "窗口"],
        "icon": "icons/app.svg",
        "entry": "index.html",
        "windowMode": "standalone",
        "rect": {
          "x": "center",
          "y": "center"
        },
        "sessionVersion": 1
      }
    ],
    "actions": [
      {
        "id": "open-input",
        "name": "使用当前输入",
        "keywords": ["input", "输入", "图片"],
        "icon": "icons/app.svg",
        "accepts": ["text", "image"],
        "app": "main"
      },
      {
        "id": "say-hello",
        "name": "Hello 一下",
        "keywords": ["hello", "示例"],
        "icon": "icons/app.svg",
        "accepts": ["text"],
        "command": "hello"
      }
    ],
    "commands": [
      {
        "id": "hello",
        "title": "Hello",
        "visibility": "private"
      }
    ],
    "mcpTools": [
      {
        "name": "say-hello",
        "description": "Write a greeting to the plugin log and show a notification",
        "command": "hello",
        "inputSchema": {
          "type": "object",
          "properties": {
            "who": {
              "type": "string",
              "minLength": 1,
              "description": "Name to greet (who receives the Hello notification)"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "who": {
              "type": "string",
              "description": "Name that was greeted"
            },
            "timestamp": {
              "type": "string",
              "description": "ISO-8601 timestamp when the greeting was written"
            },
            "logPath": {
              "type": "string",
              "description": "Absolute path to the plugin log file"
            },
            "loud": {
              "type": "boolean",
              "description": "Whether loud uppercase greeting was used"
            },
            "theme": {
              "type": "string",
              "description": "Plugin theme setting value (auto|light|dark)"
            },
            "langs": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Selected language codes from plugin settings"
            },
            "greeting": {
              "type": "string",
              "description": "Final greeting text after applying loud setting"
            }
          },
          "required": ["who", "timestamp", "logPath", "loud", "theme", "langs", "greeting"],
          "additionalProperties": false
        },
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        }
      }
    ],
    "settings": [
      {
        "id": "loud",
        "type": "switch",
        "title": "大声打招呼",
        "description": "通知文案使用大写",
        "default": false
      },
      {
        "id": "theme",
        "type": "select",
        "title": "主题",
        "description": "示例单选设置（仅用于测试设置 UI）",
        "default": "auto",
        "options": [
          { "value": "auto", "label": "跟随系统" },
          { "value": "light", "label": "浅色" },
          { "value": "dark", "label": "深色" }
        ]
      },
      {
        "id": "langs",
        "type": "multiselect",
        "title": "语言",
        "description": "示例多选设置（仅用于测试设置 UI）",
        "default": ["zh"],
        "options": [
          { "value": "zh", "label": "中文" },
          { "value": "en", "label": "English" }
        ]
      },
      {
        "id": "default-who",
        "type": "input",
        "title": "默认称呼",
        "description": "未传入 who 时使用的名字",
        "default": "world",
        "placeholder": "world"
      }
    ]
  }
}
